def get_normalization_info(normalization_config):
    """
    Returns both the normalized criteria list and the norms applied dictionary.
    
    Args:
        normalization_config: Dictionary with normalization configuration
        
    Returns:
        tuple: (normed_criterias_list, norms_applied_dict)
    """
    normed_criterias_list = []
    norms_applied = {}
    
    for criteria_name, config in normalization_config.items():
        norm_type = config['normalization_type']
        
        if norm_type == 'period':
            norm_period = config['norm_period']
            normalized_name = f"{criteria_name}_normalized_{norm_period}_year"
            normed_criterias_list.append(normalized_name)
            norms_applied[normalized_name] = f"{norm_period}y"
        
        elif norm_type == 'distance':
            norm_distance = config['norm_distance']
            normalized_name = f"{criteria_name}_normalized_{norm_distance}_Km"
            normed_criterias_list.append(normalized_name)
            norms_applied[normalized_name] = f"{norm_distance}km"
        
        elif norm_type == 'both':
            norm_period = config['norm_period']
            norm_distance = config['norm_distance']
            normalized_name = f"{criteria_name}_normalized_final_min_{norm_period}_year_and_{norm_distance}_Km"
            normed_criterias_list.append(normalized_name)
            norms_applied[normalized_name] = f"{norm_period}y_{norm_distance}km"
    
    return normed_criterias_list, norms_applied

def create_pfm_batch_structure(df_normalized_weighted,modeling_df, Normalization_config, note_usage_sample, sample_description, study_name):
    import ast
    
    params_dict = ast.literal_eval(sample_description)
    normed_criterias_list, norm_applied = get_normalization_info(Normalization_config)
    dimensions = auto_detect_dimensions(df_normalized_weighted, normed_criterias_list)
    
    # Issue for matrices since only 1 matrix can be handled at a time
    matrices = {}
    for criteria in normed_criterias_list:
        print(f"Creating matrix for {criteria}...")
        matrices[criteria] = create_nested_matrix_from_df(
            df_normalized_weighted, 
            criteria
        )
        print(f"  ✅ Matrix created: {len(matrices[criteria])} bins")
    
    # Build batch
    builder = PFMBatchStructureBuilder()
    
    # Set study-level metadata ONCE
    builder.set_study_title(study_name)
    builder.set_population(
        params_dict['list_vin'], 
        note_usage_sample["category"],  # These variables need to be defined or passed as parameters
        note_usage_sample["segment"], 
        note_usage_sample["country"]
    )
    builder.set_data_source(
        params_dict['source'], 
        params_dict['signals'], 
        params_dict['start_date'], 
        params_dict['end_date']
    )
    
    for criteria in normed_criterias_list:
        builder.add_criteria(
            label=criteria,
            description="",
            dimension=dimensions[criteria],
            norm_applied=norm_applied[criteria],
            modeling_df=modeling_df,  
            matrix=matrices.get(criteria),  # None if not present
            boundaries={
                "x_axis": "regime_mel",
                "y_axis": "couple_mel",
                "x_bins": "min=-75;max=10450;step=50",
                "y_bins": "min=-3997.5;max=4997.5;step=5"
            } if criteria in matrices else None
        )
    
    batch_result = builder.build()
    return batch_result 

def store_insights_hnd(df_new, level, table_name=None, study_title=None, overwrite=False):
    from pyspark.sql import SparkSession
    import pyspark.sql.functions as F
    import json
    
    # Initialize SparkSession ONCE at the beginning
    spark = SparkSession.builder.getOrCreate()
   
    if level.upper() == "TRIP_ID":
        if table_name is None:
            table_name = "dafe_dev.customer_knowledge_utils.ck_trips_insights_ivdp"
        store_trip_insights(df_new, table_name=table_name, study_title=study_title, overwrite=overwrite)
        print(f"✅ Trip insights stored to {table_name}")
        return None
 
    elif level.upper() == "DRIVER_ID":
        if table_name is None:
            table_name = "dafe_dev.customer_knowledge_utils.ck_drivers_insights_ivdp"
        store_drivers_insights(df_new, table_name=table_name, study_title=study_title, overwrite=overwrite)
        print(f"✅ Driver insights stored to {table_name}")
        return None
 
    elif level.upper() == "PFM":
        main_table = "dafe_dev.customer_knowledge_utils.ck_pfm_insights_main"
        ndim_table = "dafe_dev.customer_knowledge_utils.insight_values_Ndim"
       
        # Validate input structure
        if not isinstance(df_new, dict):
            raise ValueError("For PFM level, df_new must be a dictionary with 'study_metadata' and 'criteria_rows'")
       
        if "study_metadata" not in df_new or "criteria_rows" not in df_new:
            raise ValueError("PFM input must contain 'study_metadata' and 'criteria_rows' keys")
       
        study_metadata = df_new["study_metadata"]
        criteria_rows = df_new["criteria_rows"]
       
        # Check if study_ref already exists (spark is now defined above)
        if spark.catalog.tableExists(main_table):
            existing_studies = spark.read.table(main_table) \
                .filter(F.col("Study_title") == study_metadata.get("Study_title")) \
                .select("Study_ref") \
                .distinct()
           
            if existing_studies.count() > 0:
                study_ref = existing_studies.first().Study_ref
                print(f"📚 Found existing study - reusing Study_ref: {study_ref}")
            else:
                study_ref = generate_study_ref(study_metadata.get("Study_title", "Untitled"))
                print(f"✨ New study - generated Study_ref: {study_ref}")
        else:
            study_ref = generate_study_ref(study_metadata.get("Study_title", "Untitled"))
            print(f"📊 Generated new Study_ref: {study_ref}")
       
        # Build Population_description JSON string
        population_description = json.dumps({
            "Energy_category": study_metadata.get("Energy_category"),
            "Segment": study_metadata.get("Segment"),
            "Region_country": study_metadata.get("region_country")
        })
       
        # Build Sample_definition JSON string
        sample_definition = json.dumps({
            "Data_source": study_metadata.get("Data_source"),
            "Vin_list": study_metadata.get("Vin_list"),
            "Period_date_start": study_metadata.get("Period_date_start"),
            "Period_date_end": study_metadata.get("Period_date_end"),
            "List_of_signal_names": study_metadata.get("List_of_signal_names")
        })
       
        main_rows = []
        all_ndim_records = []
       
        # Process each criteria
        for criteria_row in criteria_rows:
            has_modeling = (criteria_row.get("loi") is not None)
            dimension = criteria_row.get("Dimension", "H0D")
           
            if has_modeling:
                composite_key = None          
            else:
                composite_key = f"{criteria_row['Criteria_label']}_{study_ref}"
                print(f"📚 Generated CriteriaValuesNdimRef: {composite_key}")          
           
            main_row = {
                "Study_ref": study_ref,
                "CriteriaValuesNdimRef": composite_key,
                "Study_title": study_metadata.get("Study_title"),
                "Criteria_label": criteria_row["Criteria_label"],
                "Norm_applied": criteria_row.get("Norm_applied"),
                "Population_description": population_description,  
                "Sample_definition": sample_definition,  
                "Final_stats_min_max_moyenne": criteria_row.get("Final_stats_min_max_moyenne"),
                "loi": criteria_row.get("loi"),
                "parameters": criteria_row.get("parameters"),
                "class_index": criteria_row.get("class_index"),
                "R2": criteria_row.get("R2"),
                "client1pct": criteria_row.get("client1pct"),
                "client50pct": criteria_row.get("client50pct"),
                "client99pct": criteria_row.get("client99pct"),
                "sample_client1pct": criteria_row.get("sample_client1pct"),
                "sample_client50pct": criteria_row.get("sample_client50pct"),
                "sample_client99pct": criteria_row.get("sample_client99pct")
            }
           
            main_rows.append(main_row)
           
            # Process dfmatrix if exists
            dfmatrix = criteria_row.get("dfmatrix")
           
            if dfmatrix and dfmatrix not in ["", "none", "None", None]:
                df_ndim = explode_matrix_to_dataframe(
                    dfmatrix_json=dfmatrix,
                    study_ref=study_ref,
                    criteria_label=criteria_row["Criteria_label"]
                )
               
                if df_ndim is not None and len(df_ndim) > 0:
                    all_ndim_records.append(df_ndim)
       
        # Store main table
        import pandas as pd
        df_main = pd.DataFrame(main_rows)
        df_main = spark.createDataFrame(df_main)
        store_pfm_insights(df_main, table_name=main_table, study_title=None)
       
        print(f"✅ Stored {len(main_rows)} criteria to main table")
       
        # Store ndim table if matrix data exists
        if len(all_ndim_records) > 0:
            df_ndim_combined = pd.concat(all_ndim_records, ignore_index=True)
            df_ndim_combined = spark.createDataFrame(df_ndim_combined)
            store_pfm_insights(df_ndim_combined, table_name=ndim_table, study_title=None)
           
            dim_summary = df_ndim_combined.groupby(['Criteria_label', 'Dimension']).size().to_dict()
            print(f"✅ Stored matrix data:")
            for (criteria, dim), count in dim_summary.items():
                print(f"   - {criteria} ({dim}): {count} records")
        else:
            print(f"⚠️  No matrix data to store")
       
        return study_ref
   
    else:
        raise ValueError(f"Invalid level '{level}'. Must be one of: 'TRIP_ID', 'DRIVER_ID', 'PFM'")
