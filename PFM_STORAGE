def get_dimension_shape(val):
    """
    Calculate the shape of a dimension based on its structure.
    - H0D (scalar): returns (1,)
    - H1D (flat dict): returns (1, len(dict))
    - H2D (nested dict): returns (len(outer_dict), len(inner_dict))
    """
    if isinstance(val, dict):
        # Check if it's H2D (nested dict)
        if any(isinstance(v, dict) for v in val.values()):
            # H2D: get the outer length and inner length
            outer_len = len(val)
            # Get the length of the first nested dict as representative
            inner_len = len(next(iter(val.values()))) if val else 0
            return f"({outer_len}, {inner_len})"
        else:
            # H1D: flat dict
            return f"(1, {len(val)})"
    else:
        # H0D: scalar
        return "(1,)"

def create_and_save_criteria_description(result_df, criterias_dict, params_dict, level, table_name = "dafe_dev.customer_knowledge_utils.ck_criteria_description"):
    from pyspark.sql import SparkSession
    import json
    import pandas as pd
    import ast
    from datetime import datetime
    
    spark = SparkSession.builder.getOrCreate()
    current_dt = datetime.now().date()
    
    records = []
    params_dict = ast.literal_eval(params_dict)
    signals_list = params_dict['signals']
    source = params_dict['source']
    
    # Collect criteria info with values for shape calculation
    criteria_info = result_df.select("criteria", "dimension", "correspondant_value").distinct().collect()
    
    # Create a mapping for quick lookup including shape
    criteria_mapping = {}
    for row in criteria_info:
        if row.criteria not in criteria_mapping:
            # Parse the value if it's a JSON string
            val = row.correspondant_value
            if isinstance(val, str):
                try:
                    val = json.loads(val)
                except:
                    pass
            
            # Only calculate shape if level is 'TRIP_ID'
            if level == 'TRIP_ID':
                shape = get_dimension_shape(val)
            else:
                shape = None
            
            criteria_mapping[row.criteria] = (row.dimension, shape)
    
    for criteria, description in criterias_dict.items():
        if criteria in criteria_mapping:
            dimension, shape = criteria_mapping[criteria]
        else:
            dimension = "Unknown"
            shape = None if level != 'TRIP_ID' else "Unknown"
        
        # Create details dictionary
        details = {
            "description": description,
            "dimension": dimension,
            "signals_list": signals_list  
        }
        
        # Only add shape to details if level is 'TRIP_ID'
        if level == 'TRIP_ID':
            details["shape"] = shape
        
        records.append({
            "criteria": criteria,
            "source": source,
            "level": level,
            "details": json.dumps(details),
            "dt": current_dt
        })
    
    criteria_details_df = pd.DataFrame(records)
    
    criteria_details_spark_df = spark.createDataFrame(criteria_details_df)
    
